<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Clock Group -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clock_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.zenith.launcher.ui.widget.ClockArcView
            android:layout_width="180dp"
            android:layout_height="180dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            
            <TextClock
                android:id="@+id/text_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:fontFamily="@font/orbitron"
                android:format24Hour="HH:mm:ss"
                android:format12Hour="hh:mm:ss" />

            <TextClock
                android:id="@+id/text_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/orbitron"
                android:layout_marginTop="8dp"
                android:format24Hour="EEEE, MMMM d"
                android:format12Hour="EEEE, MMMM d" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Favorite Apps -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="140dp"
        android:layout_marginStart="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/fav_atom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atom"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingVertical="8dp"
            android:fontFamily="@font/orbitron"
            android:background="?android:attr/selectableItemBackground" />
            
        <TextView
            android:id="@+id/fav_finch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Finch"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingVertical="8dp"
            android:fontFamily="@font/orbitron"
            android:background="?android:attr/selectableItemBackground" />
            
        <TextView
            android:id="@+id/fav_phonepe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PhonePe"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingVertical="8dp"
            android:fontFamily="@font/orbitron"
            android:background="?android:attr/selectableItemBackground" />
            
        <TextView
            android:id="@+id/fav_regain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Regain"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingVertical="8dp"
            android:fontFamily="@font/orbitron"
            android:background="?android:attr/selectableItemBackground" />
            
        <TextView
            android:id="@+id/fav_homeworkout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home Workout"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingVertical="8dp"
            android:fontFamily="@font/orbitron"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

    <!-- Bottom Icons -->
    <ImageView
        android:id="@+id/icon_phone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="32dp"
        android:src="@drawable/ic_phone"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/icon_camera"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="32dp"
        android:src="@drawable/ic_camera"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
